# Secrets — never commit
.env
.hackathon-secrets.env
*.secret

# Python
__pycache__/
*.pyc
.venv/
venv/

# Build / package output
node_modules/
build/
stage/
dist/
temp-package/
src/main/resources/splunk/

# Third-party apps the integration harness installs (e.g. Splunk MCP Server).
# Operator-supplied (Splunkbase / a local package), never committed.
vendor/

# Recovered build artefacts we never commit (regenerated by webpack)
app/appserver/static/pages/
app/appserver/static/js/build/

# Scratch / secrets the harness writes (e.g. the minted MCP-audience token)
.tmp/

# Test output
test-results/
playwright-report/
.pytest_cache/
coverage.xml
htmlcov/
.coverage

# AppInspect report
appinspect-report.json

# Playwright harness build output
tests/e2e/harness/dist/

# OS / editor
.DS_Store
*.swp
test-results
